{
  "name": "@oarkflow/codec",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript interoperability for the Codec binary format",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oarkflow/codec.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:examples": "tsc -p tsconfig.examples.json",
    "test": "npm run build && npm run check:examples && node --test test/*.test.mjs && node examples/basic.mjs",
    "bench": "node bench/readiness.mjs"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  },
  "license": "MIT"
}
